# SvaraCall trained LLM (OpenAI-compatible chat completions)
# POST body shape: { model, messages: [{ role, content }], temperature, max_tokens }
# Expected response: { choices: [{ message: { content } }] }
# Also accepts { reply }, { message }, or { content } at the top level.

SVARACALL_LLM_API_URL=
SVARACALL_LLM_API_KEY=
SVARACALL_LLM_MODEL=svaracall

# Pilot launch campaign (public, safe to expose)
# Absolute ISO-8601 instant. Default: 2026-09-14T12:15:00+05:30
NEXT_PUBLIC_LAUNCH_AT=
# Destination after the campaign gate. Default: https://app.svaracall.com
NEXT_PUBLIC_PILOT_ACCESS_URL=
# Serve /launch at / until this instant. Default: same as NEXT_PUBLIC_LAUNCH_AT
NEXT_PUBLIC_LAUNCH_HOME_UNTIL=
